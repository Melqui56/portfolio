---
import OceanBackground from './OceanBackground.astro';
import Reveal from './Reveal.astro';
import { ui, defaultLang } from '../i18n/ui';
import { getCollection } from 'astro:content';
import { sections, localisePath } from '../i18n/sections';

interface Props {
  lang: keyof typeof ui;
}

const { lang } = Astro.props;
const t = (key: keyof typeof ui[typeof defaultLang]) => ui[lang][key] || ui[defaultLang][key];

const l = (path: string) => localisePath(path, lang);

const featuredProjects = (await getCollection('projects'))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);

const pillars = [
  { n: '01', title: t('hero.pillar.engineering'), body: t('pillars.engineering.body'), border: 'border-l-blood-moon' },
  { n: '02', title: t('hero.pillar.craft'), body: t('pillars.craft.body'), border: 'border-l-brass' },
  { n: '03', title: t('hero.pillar.management'), body: t('pillars.management.body'), border: 'border-l-neon-cyan' },
];

const proofPoints = [t('proof.adr'), t('proof.stack'), t('proof.i18n')];

/** The site is multi-page: the Deck is an index, not a container. */
const chart = sections
  .filter((s) => s.key !== 'contact')
  .map((s) => ({
    href: s.href,
    n: s.n,
    label: t(`nav.${s.key}` as Parameters<typeof t>[0]),
    body: t(`chart.${s.key}` as Parameters<typeof t>[0]),
  }));

---

<!-- ============ DECK / HERO ============ -->
<section class="relative min-h-[88vh] flex items-center overflow-hidden">
  <OceanBackground label={t('hero.ship')} />

  <!-- Sea fades into the page below so the hero has no hard seam. -->
  <div
    class="pointer-events-none absolute inset-x-0 bottom-0 h-40 bg-gradient-to-b from-transparent to-abyss-950"
    aria-hidden="true"
  >
  </div>

  <div class="relative z-10 w-full mx-auto max-w-6xl px-6 py-24">
    <div class="max-w-3xl">
      <p class="eyebrow mb-5 bleed-in">{t('hero.eyebrow')}</p>

      <h1 class="bleed-in text-[clamp(2.5rem,6.5vw,5.25rem)] font-extrabold leading-[0.95] tracking-tight text-ink-100">
        Melqui Casallas
      </h1>

      <p class="mt-3 font-serif italic text-[clamp(1.25rem,2.4vw,1.85rem)] text-brass">
        MQE — Master Quality Expedition
      </p>

      <div class="mt-7 max-w-xl">
        <div class="rule-chart w-24 mb-5" aria-hidden="true"></div>
        <p class="text-lg md:text-xl text-ink-300">{t('hero.role')}</p>
        <p class="mt-3 font-serif italic text-xl md:text-2xl text-blood-moon text-glow-blood">
          {t('hero.tagline')}
        </p>
      </div>

      <div class="mt-9 flex flex-wrap gap-4">
        <a
          href={l('/projects')}
          class="px-7 py-3.5 rounded font-mono text-sm font-semibold bg-blood-moon text-abyss-950 hover:bg-vampire-300 hover:shadow-[0_0_32px_rgba(255,42,109,0.45)] transition-all"
        >
          {t('hero.ctaWork')} →
        </a>
        <a
          href={l('/about')}
          class="px-7 py-3.5 rounded font-mono text-sm border border-ink-700 text-ink-300 hover:border-blood-moon hover:text-blood-moon transition-colors"
        >
          {t('hero.ctaLog')}
        </a>
      </div>
    </div>
  </div>

  <div
    class="absolute bottom-6 left-1/2 -translate-x-1/2 flex flex-col items-center gap-2 text-ink-500"
    aria-hidden="true"
  >
    <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em]">{t('hero.scroll')}</span>
    <span class="animate-bounce text-blood-moon">▼</span>
  </div>
</section>


<!-- ============ THREE PILLARS ============ -->
<section class="mx-auto max-w-6xl px-6 pb-20 md:pb-28">
  <Reveal>
    <p class="eyebrow mb-8"><span class="text-brass">◆</span> {t('pillars.eyebrow')}</p>
  </Reveal>

  <div class="grid grid-cols-1 sm:grid-cols-3 gap-5">
    {
      pillars.map((p, i) => (
        <Reveal delay={i * 0.1}>
          <div class={`glass h-full rounded-lg p-7 border-l-2 ${p.border}`}>
            <span class="font-mono text-xs text-ink-500">{p.n}</span>
            <h3 class="mt-2 text-lg font-semibold text-ink-100">{p.title}</h3>
            <p class="mt-3 text-sm text-ink-300 leading-relaxed">{p.body}</p>
          </div>
        </Reveal>
      ))
    }
  </div>
</section>

<!-- ============ SELECTED WORK ============ -->
<section class="border-y border-ink-700/40 bg-abyss-900/30">
  <div class="mx-auto max-w-6xl px-6 py-20 md:py-28">
    <Reveal>
      <div class="flex flex-wrap items-end justify-between gap-6">
        <div>
          <p class="eyebrow"><span class="text-blood-moon">◆</span> {t('work.eyebrow')}</p>
          <h2 class="mt-3 text-3xl md:text-5xl font-bold tracking-tight">{t('work.title')}</h2>
          <p class="mt-5 max-w-xl text-lg text-ink-300">{t('work.lead')}</p>
        </div>
        <a
          href={l('/projects')}
          class="font-mono text-sm text-blood-moon hover:text-vampire-300 transition-colors whitespace-nowrap"
        >
          {t('work.all')} →
        </a>
      </div>
    </Reveal>

    {
      featuredProjects.length > 0 ? (
        <div class="mt-12 grid grid-cols-1 md:grid-cols-3 gap-6">
          {featuredProjects.map((p, i) => (
            <Reveal delay={0.1 + i * 0.1}>
              <a
                href={l(`/projects/${p.id}`)}
                class="poster-glitch glass rounded-lg p-7 flex flex-col h-full hover:border-blood-moon/50 hover:shadow-[0_0_36px_rgba(255,42,109,0.14)] transition-all group"
              >
                <span class="font-mono text-xs text-brass">{p.data.bounty ?? '—'}</span>
                <h3 class="mt-2 text-lg font-semibold text-ink-100 group-hover:text-blood-moon transition-colors">
                  {p.data.title}
                </h3>
                <p class="mt-3 text-sm text-ink-300 leading-relaxed line-clamp-3">{p.data.description}</p>
                <div class="mt-auto pt-5 flex flex-wrap gap-2">
                  {p.data.stack.slice(0, 4).map((s) => (
                    <span class="font-mono text-[0.7rem] px-2 py-0.5 rounded border border-ink-700 text-ink-500">
                      {s}
                    </span>
                  ))}
                </div>
              </a>
            </Reveal>
          ))}
        </div>
      ) : (
        <Reveal>
          <p class="mt-14 font-mono text-sm text-ink-500 border border-dashed border-ink-700 rounded-lg p-10 text-center">
            {t('work.empty')}
          </p>
        </Reveal>
      )
    }
  </div>
</section>

<!-- ============ THIS SITE AS PROOF ============ -->
<section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <div class="grid grid-cols-1 lg:grid-cols-2 gap-14 items-center">
    <Reveal>
      <div>
        <p class="eyebrow"><span class="text-neon-cyan">◆</span> {t('proof.eyebrow')}</p>
        <h2 class="mt-3 text-3xl md:text-5xl font-bold tracking-tight">{t('proof.title')}</h2>
        <p class="mt-5 text-lg text-ink-300">{t('proof.lead')}</p>
        <a
          href={l('/roadmap')}
          class="mt-8 inline-block font-mono text-sm text-blood-moon hover:text-vampire-300 transition-colors"
        >
          {t('proof.cta')} →
        </a>
      </div>
    </Reveal>

    <Reveal delay={0.15}>
      <!-- Terminal-styled proof panel: the engineering voice, stated plainly. -->
      <div class="glass rounded-lg overflow-hidden font-mono text-sm">
        <div class="flex items-center gap-2 px-4 py-3 border-b border-ink-700/60 bg-abyss-800/60">
          <span class="w-2.5 h-2.5 rounded-full bg-blood-moon"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-brass"></span>
          <span class="w-2.5 h-2.5 rounded-full bg-neon-cyan"></span>
          <span class="ml-2 text-xs text-ink-500">mqe://portfolio</span>
        </div>
        <ul class="p-6 space-y-3">
          {
            proofPoints.map((point) => (
              <li class="flex gap-3 text-ink-300">
                <span class="text-neon-green">✓</span>
                <span>{point}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </Reveal>
  </div>
</section>


<!-- ============ THE CHART: index of every section ============ -->
<section class="mx-auto max-w-6xl px-6 py-20 md:py-28">
  <Reveal>
    <p class="eyebrow"><span class="text-brass">◆</span> {t('chart.eyebrow')}</p>
    <h2 class="mt-3 text-3xl md:text-5xl font-bold tracking-tight">{t('chart.title')}</h2>
    <p class="mt-5 max-w-2xl text-lg text-ink-300">{t('chart.lead')}</p>
  </Reveal>

  <div class="mt-12 grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 gap-px bg-ink-700/30 rounded-lg overflow-hidden">
    {
      chart.map((c, i) => (
        <Reveal delay={i * 0.06}>
          <a
            href={l(c.href)}
            class="group h-full flex flex-col bg-abyss-900/70 p-7 hover:bg-abyss-800/70 transition-colors"
          >
            <div class="flex items-baseline justify-between gap-3">
              <span class="font-mono text-xs text-ink-500">{c.n}</span>
              <span class="font-mono text-blood-moon opacity-0 group-hover:opacity-100 transition-opacity">→</span>
            </div>
            <h3 class="mt-2 text-lg font-semibold text-ink-100 group-hover:text-blood-moon transition-colors">
              {c.label}
            </h3>
            <p class="mt-2 text-sm text-ink-300 leading-relaxed">{c.body}</p>
          </a>
        </Reveal>
      ))
    }
  </div>
</section>

<!-- ============ CLOSING CTA: points at /contact, does not replace it ============ -->
<section class="relative overflow-hidden border-t border-ink-700/40">
  <div
    class="pointer-events-none absolute inset-0 bg-[radial-gradient(ellipse_at_50%_140%,rgba(255,42,109,0.14),transparent_60%)]"
    aria-hidden="true"
  >
  </div>

  <div class="relative mx-auto max-w-4xl px-6 py-24 text-center">
    <Reveal>
      <p class="font-serif italic text-2xl md:text-3xl text-ink-300">{t('hero.tagline')}</p>
      <a
        href={l('/contact')}
        class="mt-8 inline-block px-9 py-4 rounded font-mono text-sm font-semibold bg-blood-moon text-abyss-950 hover:bg-vampire-300 hover:shadow-[0_0_40px_rgba(255,42,109,0.5)] transition-all"
      >
        {t('contact.cta')} →
      </a>
    </Reveal>
  </div>
</section>
