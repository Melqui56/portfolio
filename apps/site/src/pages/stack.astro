---
import BaseLayout from '../layouts/BaseLayout.astro';
import Stack from '../components/sections/Stack.astro';
import { ui, getLangFromUrl, defaultLang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = (key: keyof typeof ui[typeof defaultLang]) => ui[lang][key] || ui[defaultLang][key];
---

<BaseLayout title={t('stack.title')} description={t('stack.lead')} lang={lang}>
  <Stack lang={lang} />
</BaseLayout>
