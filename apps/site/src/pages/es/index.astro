---
import BaseLayout from '../../layouts/BaseLayout.astro';
import DeckPage from '../../components/DeckPage.astro';
import { ui, defaultLang } from '../../i18n/ui';

const lang = 'es' as const;
const t = (key: keyof typeof ui[typeof defaultLang]) => ui[lang][key] || ui[defaultLang][key];
---

<BaseLayout title="Melqui Casallas — Ingeniero de Software" description={t('hero.tagline')} lang={lang}>
  <DeckPage lang={lang} />
</BaseLayout>
