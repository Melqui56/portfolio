---
import BaseLayout from '../layouts/BaseLayout.astro';
import Studio from '../components/sections/Studio.astro';
import { ui, getLangFromUrl, defaultLang } from '../i18n/ui';

const lang = getLangFromUrl(Astro.url);
const t = (key: keyof typeof ui[typeof defaultLang]) => ui[lang][key] || ui[defaultLang][key];
---

<BaseLayout title="MQE Studios" description={t('studio.lead')} lang={lang}>
  <Studio lang={lang} />
</BaseLayout>
