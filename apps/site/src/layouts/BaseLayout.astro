---
import '../styles/global.css';
import { ClientRouter } from 'astro:transitions';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import Maintenance from '../components/Maintenance.astro';
import { pageInMaintenance } from '../lib/maintenance';
import { getLangFromUrl } from '../i18n/ui';

interface Props {
  title: string;
  description?: string;
  lang?: 'en' | 'es';
  ogImage?: string;
  ogType?: 'website' | 'article';
  pubDate?: Date;
  author?: string;
  robots?: string;
}

const { title, description, lang, ogImage, ogType = 'website', pubDate, author = 'Melquisedec Casallas', robots } =
  Astro.props;
const currentLang = lang ?? getLangFromUrl(Astro.url);
const inMaintenance = pageInMaintenance(Astro.url.pathname);
const site = Astro.site ?? new URL('https://mqestudios.com');
const canonical = new URL(Astro.url.pathname, site);
const defaultDescription =
  currentLang === 'es'
    ? 'Ingeniero de Software y desarrollador de videojuegos. MQE Studios.'
    : 'Software Engineer and Game Developer. MQE Studios.';
const maintenanceTitle = currentLang === 'es' ? 'MQE — En mantenimiento' : 'MQE — Under maintenance';
const pageTitle = inMaintenance
  ? maintenanceTitle
  : title.includes('MQE')
    ? title
    : `${title} — MQE`;
const descriptionValue = inMaintenance
  ? (currentLang === 'es'
      ? 'El sitio está en mantenimiento. Vuelve pronto.'
      : 'The site is under maintenance. Coming back soon.')
  : (description ?? defaultDescription);

const localeMap = { en: 'en_US', es: 'es_ES' } as const;
const ogLocale = localeMap[currentLang];
const altLocale = localeMap[currentLang === 'es' ? 'en' : 'es'];
const esPath = `/es${Astro.url.pathname === '/' ? '' : Astro.url.pathname}`;
const imageUrl = ogImage ? new URL(ogImage, site) : new URL('/og.png', site);

const sameAs = [
  'https://github.com/Melqui56',
  'https://www.linkedin.com/in/melquisedec-casallas',
];

const schemaGraph = [
  {
    '@type': 'WebSite',
    '@id': new URL('/#website', site).href,
    url: site.href,
    name: 'MQE — Master Quality Expedition',
    description: defaultDescription,
    inLanguage: currentLang === 'es' ? 'es' : 'en',
    publisher: {
      '@id': new URL('/#person', site).href,
    },
  },
  {
    '@type': 'Person',
    '@id': new URL('/#person', site).href,
    name: 'Melquisedec Casallas',
    url: site.href,
    jobTitle: currentLang === 'es' ? 'Ingeniero de Software' : 'Software Engineer',
    sameAs,
  },
];

if (ogType === 'article' && pubDate) {
  schemaGraph.push({
    '@type': 'Article',
    headline: pageTitle,
    datePublished: pubDate.toISOString(),
    author: { '@id': new URL('/#person', site).href },
    publisher: { '@id': new URL('/#website', site).href },
    inLanguage: currentLang === 'es' ? 'es' : 'en',
  });
}

const schemaJson = JSON.stringify({ '@context': 'https://schema.org', '@graph': schemaGraph });
---

<!doctype html>
<html lang={currentLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <ClientRouter />

    <!-- Primary Meta Tags -->
    <title>{pageTitle}</title>
    <meta name="title" content={pageTitle} />
    <meta name="description" content={descriptionValue} />
    <meta name="author" content={author} />
    <meta name="robots" content={robots ?? (inMaintenance ? 'noindex, nofollow' : 'index, follow')} />
    <meta name="theme-color" content="#05070f" />
    <meta name="color-scheme" content="dark" />
    <link rel="canonical" href={canonical.href} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical.href} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={descriptionValue} />
    <meta property="og:image" content={imageUrl.href} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:site_name" content="MQE — Master Quality Expedition" />
    <meta property="og:locale" content={ogLocale} />
    <meta property="og:locale:alternate" content={altLocale} />
    {
      ogType === 'article' && pubDate && (
        <meta property="article:published_time" content={pubDate.toISOString()} />
      )
    }

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={pageTitle} />
    <meta name="twitter:description" content={descriptionValue} />
    <meta name="twitter:image" content={imageUrl.href} />

    <!-- i18n SEO: hreflang alternates derive from the configured site URL -->
    <link rel="alternate" hreflang="en" href={new URL(Astro.url.pathname, site).href} />
    <link rel="alternate" hreflang="es" href={new URL(esPath, site).href} />
    <link rel="alternate" hreflang="x-default" href={new URL(Astro.url.pathname, site).href} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={schemaJson} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="apple-touch-icon" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Cormorant+Garamond:ital,wght@0,400;0,600;1,400;1,600&display=swap"
    />

    <!-- Mark the page as JS-capable before first paint; .reveal stays visible
         without it, so no-JS and noscript visitors see the full content. -->
    <script is:inline>
      document.documentElement.classList.add('js');
    </script>
  </head>
  <body class="min-h-screen flex flex-col scanlines">
    {
      inMaintenance ? (
        <Maintenance lang={currentLang} />
      ) : (
        <>
          <!-- Scroll progress: scaleX driven by src/lib/site.ts -->
          <div
            id="scroll-progress"
            class="fixed top-0 inset-x-0 h-0.5 origin-left z-[60] bg-gradient-to-r from-blood-moon via-brass to-neon-cyan"
            style="transform: scaleX(0)"
            aria-hidden="true"
          ></div>

          <Header lang={currentLang} />
          <main class="flex-1">
            <slot />
          </main>
          <Footer lang={currentLang} />
        </>
      )
    }

    <script>
      import { initSite } from '../lib/site';
      initSite();
    </script>
  </body>
</html>