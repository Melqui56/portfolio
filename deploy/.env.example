# Environment template — copy to .env and fill real values
# NEVER commit .env (it's gitignored)

# Postgres
POSTGRES_USER=mqe
POSTGRES_PASSWORD=mqe_dev_password
POSTGRES_DB=mqe
DATABASE_URL=postgres://mqe:mqe_dev_password@localhost:5432/mqe?sslmode=disable

# Site (public) — the site itself deploys to Cloudflare Workers (apps/site).
# deploy/ now backs the API + Postgres only.
SITE_URL=https://mqestudios.com
DOMAIN=mqestudios.com

# API
API_PORT=8081
GAME_PORT=8082